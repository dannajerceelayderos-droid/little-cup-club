# ── Supabase (optional — without these the app runs in demo mode with local-only saves)
# Project Settings → API. The anon key is public by design; RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Never expose the service-role key to the browser. Only use it in server-side scripts (e.g. importing curated cafés).
# SUPABASE_SERVICE_ROLE_KEY=

# ── Map tiles (optional)
# Default: free OpenFreeMap vector tiles, recoloured in the browser. No key needed.
# To use Mapbox instead, create a PUBLIC token (pk.*) restricted to your domain(s).
NEXT_PUBLIC_MAPBOX_TOKEN=
# Or point to any MapLibre-compatible style JSON:
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# ── Real café data (server-side only)
# Overpass endpoint for OpenStreetMap café queries. Defaults to the public instance.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
